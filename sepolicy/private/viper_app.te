app_domain(viper_app)

allow viper_app {
  app_function_service
  activity_service
  activity_task_service
  audio_service
  audioserver_service
  autofill_service
  batteryproperties_service
  batterystats_service
  content_capture_service
  game_service
  gpu_service
  hint_service
  media_session_service
  netstats_service
  sensitive_content_protection_service
  sensorservice_service
  surfaceflinger_service
  uimode_service
  voiceinteraction_service
  vibrator_manager_service
}:service_manager find;

allow viper_app privapp_data_file:dir create_dir_perms;
allow viper_app privapp_data_file:{ file lnk_file } create_file_perms;
